{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppSettings Schema for RtlDaemon",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "WorkerOptions": {
      "type": "object",
      "properties": {
        "Period": {
          "type": "string",
          "format": "duration"
        },
        "LogGroup": {
          "type": "string"
        }
      },
      "required": ["Period", "LogGroup"]
    },

    "TeleportOptions": {
      "type": "object",
      "properties": {
        "CredProfile": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": ["CredProfile"]
    }
  },
  "properties": {
    "$schema": {
      "const": "./settings.schema.json"
    },
    "Worker": { "$ref": "#/$defs/WorkerOptions" },
    "Teleport": { "$ref":  "#/$defs/TeleportOptions" }
  },
  "required": ["$schema", "Worker", "Teleport"]
}