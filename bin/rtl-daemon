#!/bin/bash

PLUGIN_ROOT='/home/dev/.claude/plugins/marketplaces/rtldaemon-plugin/bin'
cd $PLUGIN_ROOT
if [[ "$OSTYPE" == "linux-gnu"* ]]; then
        DAEMONPATH='rtl-daemon-linux-amd64'
elif [[ "$OSTYPE" == "darwin"* ]]; then
        DAEMONPATH='rtl-daemon-mac-arm64'
else
        echo 'Only supporting linux and mac workflows for now'
        exit 1
fi
if [[ -e "$FILE" ]]; then
    echo "Path exists (could be a file or folder)."
fi

if [ -f "${PLUGIN_ROOT}/${DAEMONPATH}.gz" ]; then
    gunzip "${PLUGIN_ROOT}/${DAEMONPATH}.gz"
fi

cd $PLUGIN_ROOT
chmod +x ./${DAEMONPATH}
./${DAEMONPATH} --stage prod